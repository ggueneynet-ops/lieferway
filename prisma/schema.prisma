generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  googleId     String?  @unique
  name         String
  phone        String?
  role         String   @default("CUSTOMER")
  locale       String   @default("de")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant    Restaurant?
  customerOrders Order[]    @relation("CustomerOrders")
  courierOrders  Order[]    @relation("CourierOrders")
  addresses      Address[]
  reviews              Review[]
  notices              CustomerNotice[]
  wayPointsBalance     Int      @default(0)
  wayPointsLedger      WayPointsLedger[]
  wayPointsRedemptions WayPointsRedemption[]
  wayPointsVouchers    WayPointsVoucher[]
  favorites            FavoriteRestaurant[]
  passwordResetTokens  PasswordResetToken[]
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String  @default("Zuhause")
  street     String
  city       String  @default("Frankfurt am Main")
  postalCode String
  notes      String?
}

model Restaurant {
  id                String   @id @default(cuid())
  ownerId           String   @unique
  owner             User     @relation(fields: [ownerId], references: [id])
  name              String
  slug              String   @unique
  description       String
  cuisine           String
  address           String
  city              String   @default("Frankfurt am Main")
  postalCode        String
  district          String?
  lat               Float?
  lng               Float?
  imageUrl          String
  logoUrl           String?
  rating            Float    @default(0)
  reviewCount       Int      @default(0)
  deliveryFeeCents          Int      @default(249)
  minOrderCents             Int      @default(1000)
  etaMin                    Int      @default(25)
  etaMax                    Int      @default(45)
  maxDeliveryKm             Float?
  commissionPercent         Float    @default(8)
  pickupAllowed             Boolean  @default(true)
  launchWeekFreeDelivery    Boolean  @default(false)
  wayPointsEnabled          Boolean  @default(false)
  wayPointsDisabledByAdmin  Boolean  @default(false)
  /// Max restaurant-funded WP discount cents; null = unlimited.
  wayPointsBudgetCents      Int?
  wayPointsBudgetSpentCents Int      @default(0)
  isOpen            Boolean  @default(true)
  isActive          Boolean  @default(true)
  hoursJson         String?
  stripeAccountId           String?  @unique
  stripeOnboardingComplete  Boolean  @default(false)
  stripeChargesEnabled      Boolean  @default(false)
  stripePayoutsEnabled      Boolean  @default(false)
  stripeDetailsSubmitted    Boolean  @default(false)
  createdAt         DateTime @default(now())

  categories   MenuCategory[]
  items        MenuItem[]
  orders       Order[]
  payouts      Payout[]
  serviceAreas RestaurantServiceArea[]
  reviews      Review[]
  invoices     Invoice[]
  wayPointsRewards   WayPointsReward[]
  wayPointsCampaigns WayPointsCampaign[]
  coupons            Coupon[]
  favorites          FavoriteRestaurant[]
  offers             RestaurantOffer[]

  /// Vorbestellung (optional). Disabling stops NEW preorders only.
  preorderEnabled         Boolean  @default(false)
  preorderMaxDaysAhead    Int      @default(3)
  preorderMinLeadMinutes  Int      @default(60)
  /// JSON array of ISO weekdays 1=Mon … 7=Sun, e.g. "[1,2,3,4,5]"
  preorderWeekdaysJson    String?
  /// JSON { open: "HH:MM", close: "HH:MM" } window for scheduled slots (Europe/Berlin).
  preorderHoursJson       String?
  preorderDelivery        Boolean  @default(true)
  preorderPickup          Boolean  @default(true)
  preorderMaxConcurrent   Int?

  /// Restaurant banner on public page
  bannerText       String?
  bannerActive     Boolean   @default(false)
  bannerStartsAt   DateTime?
  bannerEndsAt     DateTime?
}

model RestaurantServiceArea {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  postalCode   String

  @@unique([restaurantId, postalCode])
  @@index([postalCode])
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  items        MenuItem[]
}

model MenuItem {
  id           String       @id @default(cuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String
  priceCents   Int
  imageUrl     String?
  isAvailable        Boolean           @default(true)
  orderItems         OrderItem[]
  wayPointsRewards   WayPointsReward[]
}

model Coupon {
  id               String    @id @default(cuid())
  code             String
  description      String    @default("")
  restaurantId     String?
  restaurant       Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// PERCENT | FIXED
  type             String    @default("PERCENT")
  discountPercent  Int?
  discountCents    Int?
  /// Cap for PERCENT discounts (cents).
  maxDiscountCents Int?
  minSubtotalCents Int?
  validFrom        DateTime?
  validTo          DateTime?
  maxTotalUses     Int?
  usesPerCustomer  Int?
  usageCount       Int       @default(0)
  isActive         Boolean   @default(true)
  /// DELIVERY | PICKUP | BOTH
  scope            String    @default("BOTH")
  /// Always RESTAURANT for new coupons (restaurant funds 100%).
  funding          String    @default("RESTAURANT")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  orders           Order[]
  usages           CouponUsage[]

  @@unique([restaurantId, code])
  @@index([code])
  @@index([restaurantId, isActive])
}

model CouponUsage {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  /// APPLIED | REVERSED
  status     String   @default("APPLIED")
  createdAt  DateTime @default(now())

  @@index([couponId, customerId])
  @@index([couponId, status])
}

model Order {
  id                    String   @id @default(cuid())
  shortCode             String   @unique
  /// Client checkout idempotency (double-submit / refresh). Unique when set.
  idempotencyKey        String?  @unique
  customerId            String
  customer              User     @relation("CustomerOrders", fields: [customerId], references: [id])
  restaurantId          String
  restaurant            Restaurant @relation(fields: [restaurantId], references: [id])
  courierId             String?
  courier               User?    @relation("CourierOrders", fields: [courierId], references: [id])
  status                String   @default("PLACED")
  fulfillmentType       String   @default("DELIVERY")
  paymentMethod         String
  paymentStatus         String
  stripePaymentIntentId String?
  couponId              String?
  coupon                Coupon?  @relation(fields: [couponId], references: [id])
  couponCode            String?
  foodSubtotalCents     Int
  deliveryFeeCents      Int
  discountCents         Int      @default(0)
  totalCents            Int
  commissionPercent     Float
  commissionCents       Int
  restaurantPayoutCents Int
  stripeChargeId        String?
  stripeTransferId      String?
  stripeFeeCents        Int      @default(0)
  stripeFeeEstimatedCents Int    @default(0)
  stripeFeeActualCents  Int      @default(0)
  applicationFeeCents   Int      @default(0)
  platformNetCommissionCents Int @default(0)
  restaurantTransferCents Int    @default(0)
  restaurantNetCents    Int      @default(0)
  platformNetCents      Int      @default(0)
  stripeFeeNote         String?
  payoutStatus          String   @default("NONE")
  refundedCents         Int      @default(0)
  refundedCommissionCents    Int @default(0)
  refundedRestaurantNetCents Int @default(0)
  refundedStripeFeeCents     Int @default(0)
  disputeStatus         String?
  stripePayoutId        String?
  street                String
  city                  String
  postalCode            String
  notes                 String?
  prepMinutes           Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  acceptedAt            DateTime?
  /// When status first became PLACED (cash create or card webhook). Used for accept timeout.
  placedAt              DateTime?
  deliveredAt           DateTime?
  /// null = ASAP; set when restaurant preorder enabled and customer picks a slot
  scheduledFor          DateTime?

  items    OrderItem[]
  review   Review?
  notices  CustomerNotice[]
  invoices Invoice[]
  refunds  StripeRefund[]
  paymentReleaseLogs PaymentReleaseLog[]

  wayPointsRewardId             String?
  wayPointsReward               WayPointsReward? @relation(fields: [wayPointsRewardId], references: [id])
  wayPointsDiscountCents        Int      @default(0)
  wayPointsFundedBy             String?
  wayPointsRestaurantShareCents Int      @default(0)
  wayPointsLieferwayShareCents  Int      @default(0)
  wayPointsEarned               Int      @default(0)
  wayPointsRedeemed             Int      @default(0)
  wayPointsEligible             Boolean  @default(false)
  wayPointsLedger               WayPointsLedger[]
  wayPointsRedemption           WayPointsRedemption?
  wayPointsVouchers             WayPointsVoucher[]
  couponUsage                   CouponUsage?

  @@index([stripePaymentIntentId])
  @@index([stripeChargeId])
  @@index([status, paymentStatus])
  @@index([restaurantId, scheduledFor])
}

model CustomerNotice {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  title     String
  body      String
  emailTo   String
  emailSent Boolean   @default(false)
  emailChannel String @default("demo")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([orderId, status])
  @@index([userId, createdAt])
}

model Review {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?
  reply        String?
  repliedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String
  priceCents Int
  quantity   Int
}

model Payout {
  id                     String     @id @default(cuid())
  restaurantId           String
  restaurant             Restaurant @relation(fields: [restaurantId], references: [id])
  weekStart              DateTime
  weekEnd                DateTime
  foodTotalCents         Int
  commissionCents        Int
  netPayoutCents         Int
  cashCommissionDueCents Int        @default(0)
  cardPayoutCents        Int        @default(0)
  status                 String     @default("PENDING")
  stripePayoutId         String?    @unique
  arrivalDate            DateTime?
  failureMessage         String?
  paidAt                 DateTime?
  createdAt              DateTime   @default(now())

  @@unique([restaurantId, weekStart])
}

model StripeEvent {
  id          String    @id
  type        String
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model StripeRefund {
  id                         String   @id @default(cuid())
  stripeRefundId             String   @unique
  orderId                    String
  order                      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents                Int
  status                     String
  reason                     String?
  commissionReversalCents    Int      @default(0)
  restaurantNetReversalCents Int      @default(0)
  stripeFeeReversalCents     Int      @default(0)
  createdAt                  DateTime @default(now())

  @@index([orderId])
}


model PaymentReleaseLog {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// CANCEL_PI | REFUND | EXPIRE | CASH_NOOP
  action      String
  /// restaurant_reject | customer_cancel | restaurant_timeout | admin_refund | …
  reason      String
  /// OK | FAILED | SKIPPED
  status      String
  detail      String?
  amountCents Int?
  stripeId    String?
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model Invoice {
  id           String    @id @default(cuid())
  type         String
  status       String    @default("ISSUED")
  number       String    @unique
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String?
  periodStart  DateTime?
  periodEnd    DateTime?
  pdfPath      String
  totalCents   Int
  locale       String    @default("de")
  createdAt    DateTime  @default(now())

  @@index([orderId])
  @@index([restaurantId, type])
  @@index([customerId])
}

model PartnerApplication {
  id           String    @id @default(cuid())
  businessName String
  cuisine      String
  street       String
  postalCode   String
  city         String    @default("Frankfurt am Main")
  contactName  String
  email        String
  phone        String
  website      String?
  message      String?
  desiredSlug  String?
  status       String    @default("PENDING")
  adminNote    String?
  restaurantId String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([email])
}


model FavoriteRestaurant {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@index([userId, createdAt])
  @@index([restaurantId])
}

/// Restaurant-funded public promos (display). No Lieferway financing.
model RestaurantOffer {
  id               String     @id @default(cuid())
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title            String
  description      String     @default("")
  /// PERCENT | FIXED | INFO
  type             String     @default("INFO")
  discountPercent  Int?
  discountCents    Int?
  minOrderCents    Int?
  validFrom        DateTime?
  validTo          DateTime?
  isActive         Boolean    @default(true)
  /// DELIVERY | PICKUP | BOTH
  scope            String     @default("BOTH")
  /// Always RESTAURANT — no platform financing
  funding          String     @default("RESTAURANT")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([restaurantId, isActive])
}

/// Platform-wide WayPoints config. Single row, id = "default".
model WayPointsSettings {
  id            String   @id @default("default")
  pointsPerEuro Int      @default(10)
  updatedAt     DateTime @updatedAt
}

model WayPointsLedger {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int
  type         String
  uniqueKey    String   @unique
  title        String
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rewardId     String?
  reward       WayPointsReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  campaignId   String?
  campaign     WayPointsCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  restaurantId String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([type])
}

model WayPointsReward {
  id                 String    @id @default(cuid())
  restaurantId       String
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title              String
  description        String    @default("")
  pointsCost         Int
  type               String
  percentOff         Int?
  discountCents      Int?
  freeMenuItemId     String?
  freeMenuItem       MenuItem? @relation(fields: [freeMenuItemId], references: [id], onDelete: SetNull)
  minOrderCents      Int?
  validFrom          DateTime?
  validUntil         DateTime?
  usageLimit         Int?
  perCustomerLimit   Int?      @default(1)
  usageCount         Int       @default(0)
  isActive           Boolean   @default(true)
  fundedBy           String    @default("RESTAURANT")
  restaurantShareBps Int       @default(10000)
  lieferwayShareBps  Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  redemptions WayPointsRedemption[]
  ledger      WayPointsLedger[]
  orders      Order[]

  @@index([restaurantId, isActive])
}

model WayPointsCampaign {
  id                 String    @id @default(cuid())
  title              String
  description        String    @default("")
  type               String
  multiplier         Float?
  bonusPoints        Int?
  bonusDiscountCents Int?
  fundedBy           String    @default("LIEFERWAY")
  restaurantId       String?
  restaurant         Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  validFrom          DateTime?
  validUntil         DateTime?
  isActive           Boolean   @default(true)
  firstOrderOnly     Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  ledger   WayPointsLedger[]
  vouchers WayPointsVoucher[]

  @@index([isActive, type])
}

model WayPointsRedemption {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId              String   @unique
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rewardId             String
  reward               WayPointsReward @relation(fields: [rewardId], references: [id])
  pointsSpent          Int
  discountCents        Int
  fundedBy             String
  restaurantShareCents Int
  lieferwayShareCents  Int
  status               String   @default("APPLIED")
  createdAt            DateTime @default(now())

  @@index([userId, rewardId])
}

model WayPointsVoucher {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  discountCents Int
  fundedBy      String    @default("LIEFERWAY")
  expiresAt     DateTime?
  redeemedAt    DateTime?
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  campaignId    String?
  campaign      WayPointsCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([userId, redeemedAt])
}

/// Idempotent transactional email send log (unique eventKey prevents duplicate sends).
model EmailSendLog {
  id                String    @id @default(cuid())
  eventKey          String    @unique
  eventType         String
  toEmail           String
  subject           String
  status            String    @default("PENDING")
  provider          String?
  providerMessageId String?
  attemptCount      Int       @default(0)
  lastError         String?
  metadataJson      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentAt            DateTime?

  @@index([eventType, createdAt])
  @@index([toEmail, createdAt])
  @@index([status, updatedAt])
}

/// Admin / privileged action audit trail (who did what, when).
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actorEmail   String?
  /// ORDER_CANCEL | ORDER_REFUND | RESTAURANT_FREEZE | RESTAURANT_UNFREEZE | COMMISSION_UPDATE | WAYPOINTS_ADJUST | …
  action       String
  entityType   String
  entityId     String?
  summary      String
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}



model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the opaque reset token (never store plaintext).
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
