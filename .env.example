# Postgres connection string. Leave empty here — copy to .env and fill in.
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Neon (direct / migrate + app): postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require
# Neon pooled (app only): host is ep-XXXX-pooler.REGION.aws.neon.tech — use the non-pooler URL for prisma migrate
# Vercel Postgres: paste DATABASE_URL from the project's Storage tab
# Local docker compose: postgresql://lieferway:lieferway@127.0.0.1:5432/lieferway
DATABASE_URL=""
# openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Public origin for restaurant vanity URLs, OAuth redirects, and QR codes.
# Local: http://127.0.0.1:43123
# Production: https://app.lieferway.de
NEXT_PUBLIC_APP_URL="http://127.0.0.1:43123"
# Expo / native clients. Same origin as NEXT_PUBLIC_APP_URL in production.
EXPO_PUBLIC_API_URL="http://127.0.0.1:43123"

# Google sign-in (customers only). Leave empty to use the demo stub at /login/google.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web).
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Production: https://app.lieferway.de/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Customer order emails (accept / reject / out / delivered). First match wins:
# 1) RESEND_API_KEY  2) SMTP_HOST  3) MAIL_WEBHOOK_URL  4) demo console log
# MAIL_FROM="Lieferway <noreply@lieferway.de>"
# Public contact (Impressum) is info@lieferway.de. MAIL_FROM="Lieferway <info@lieferway.de>" is allowed if that mailbox is verified for sending.
# RESEND_API_KEY=""
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"
# MAIL_WEBHOOK_URL=""

# Invoice issuer (Provisionsrechnung / Rechnung). Aligns with the public Impressum.
# Unset fields show "Demo-Platzhalter". Do not invent other tax numbers.
# LIEFERWAY_LEGAL_NAME="Gökhan Güney"
# LIEFERWAY_ADDRESS="Waldstr. 6, 64732 Bad König"
# LIEFERWAY_UST_ID="DE331265637"

# Stripe Connect TEST MODE (sk_test_ / pk_test_ / whsec_test). Never commit live keys.
# Destination charges: PaymentIntent.transfer_data.destination + application_fee_amount.
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded,
# refund.updated, charge.dispute.*, payout.*, account.updated (+ Connect events).
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Destination charges: Stripe fee is taken from the platform. application_fee
# = net commission (~5% of food) + estimated Stripe fee (+ delivery − discount).
# Defaults = DE card pricing (1.5% + 0,25 €). Estimates only — actual fee is
# reconciled from the Balance Transaction on payment_intent.succeeded.
# STRIPE_FEE_PERCENT_BPS="150"
# STRIPE_FEE_FIXED_CENTS="25"

# Restaurant must accept a PLACED order within this many minutes (default 15).
# Cron: GET /api/cron/expire-orders every ~5 min (external scheduler; Vercel Hobby cannot use sub-daily vercel.json crons) → REJECTED + cancel/refund.
# RESTAURANT_ACCEPT_TIMEOUT_MINUTES="15"
# Protect the expire cron (Vercel sends Authorization: Bearer $CRON_SECRET).
# CRON_SECRET="replace-with-a-long-random-string"
