# Local SQLite file. Vercel serverless cannot persist this — production needs Postgres
# (Neon or Vercel Postgres). Do not deploy with file:./dev.db.
DATABASE_URL="file:./dev.db"
# openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Public origin for restaurant vanity URLs, OAuth redirects, and QR codes.
# Local: http://127.0.0.1:43123
# Production: https://app.lieferway.de
NEXT_PUBLIC_APP_URL="http://127.0.0.1:43123"
# Expo / native clients. Same origin as NEXT_PUBLIC_APP_URL in production.
EXPO_PUBLIC_API_URL="http://127.0.0.1:43123"

# Google sign-in (customers only). Leave empty to use the demo stub at /login/google.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web).
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Production: https://app.lieferway.de/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Customer order emails (accept / reject / out / delivered). First match wins:
# 1) RESEND_API_KEY  2) SMTP_HOST  3) MAIL_WEBHOOK_URL  4) demo console log
# MAIL_FROM="Lieferway <noreply@lieferway.de>"
# RESEND_API_KEY=""
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"
# MAIL_WEBHOOK_URL=""

# Invoice issuer (Provisionsrechnung / Rechnung). Unset fields show "Demo-Platzhalter"
# — never a fake DE000000000 as the VAT ID.
# LIEFERWAY_LEGAL_NAME="Lieferway GmbH"
# LIEFERWAY_ADDRESS="Musterstraße 1, 60311 Frankfurt am Main"
# LIEFERWAY_UST_ID="DE123456789"
